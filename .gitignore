# Restored 2026-08-04 after WantToCry wiped the original.
#
# IMPORTANT — READ BEFORE "TIDYING" THE BIN RULES BELOW.
# The ransomware deleted all .cs sources but left the compiled output intact.
# src/*/bin/**/Squirmify.*.dll and their .pdb files are currently the ONLY
# copy of the rebuilt backend (API controllers, Core entities, Data repos,
# Services orchestration). They are deliberately force-added and tracked.
# A stock .gitignore ignores bin/ entirely, which would hide the only
# surviving copy of that code. Do not re-ignore them until the decompiled
# sources are committed and verified to build.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
*.userprefs
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Bin, EXCEPT the surviving Squirmify assemblies + symbols (see note above)
**/[Bb]in/*
!**/[Bb]in/**/Squirmify.*.dll
!**/[Bb]in/**/Squirmify.*.pdb
!**/[Bb]in/**/Squirmify.Console
!**/[Bb]in/**/*.deps.json
!**/[Bb]in/**/*.runtimeconfig.json

# Visual Studio
.vs/
*.svclog
*.scc

# Node / frontend
node_modules/
.vite/
*.local

# SQLite working databases (seeded at runtime from the JSON test defs)
data/
*.db
*.db-shm
*.db-wal

# OS
.DS_Store
Thumbs.db
